OPENAI_API_KEY=填你的中转站或 OpenAI API Key
OPENAI_BASE_URL=https://right.codes/codex/v1
MODEL_PROVIDER=rightcode_responses_stream
RIGHTCODE_CHAT_BASE_URL=https://www.right.codes/draw
RIGHTCODE_CHAT_MODEL=gemini-3.1-pro
OPENAI_MODEL=gpt-5.5
DISABLE_RESPONSE_STORAGE=true

# 可选：语音转文字。auto 会优先尝试 Audio Transcriptions API，再兜底 macOS Speech。
SPEECH_TRANSCRIBE_PROVIDER=auto
AUDIO_TRANSCRIPTION_BASE_URL=https://right.codes/codex/v1
AUDIO_TRANSCRIPTION_MODELS=whisper-1,gpt-4o-mini-transcribe
AUDIO_TRANSCRIPTION_ENABLED=true

# 可选：Mac 本机语音转文字。默认优先设备端识别，设备端卡住时自动回退 macOS 系统识别。
MAC_SPEECH_LOCALE=zh-CN
MAC_SPEECH_ON_DEVICE_ONLY=true
MAC_SPEECH_AUTO_FALLBACK=true
