OPENAI_API_KEY=填你的中转站或 OpenAI API Key
OPENAI_BASE_URL=https://right.codes/codex/v1
MODEL_PROVIDER=rightcode_responses_stream
RIGHTCODE_CHAT_BASE_URL=https://www.right.codes/draw
RIGHTCODE_CHAT_MODEL=gemini-3.1-pro
OPENAI_MODEL=gpt-5.6-terra
# 按任务独立路由。未填写时都回退到 OPENAI_MODEL。
VISION_MODEL=gpt-5.6-terra
PLANNING_MODEL=gpt-5.6-terra
LIFE_LOG_MODEL=gpt-5.6-terra
DISABLE_RESPONSE_STORAGE=true

# 历史 Case 完整 19 例 A/B/C 未证明增益且 contrast 退化，比赛公网保持关闭。
CASE_RETRIEVAL_MODE=off
CASE_RETRIEVAL_LIMIT=4
ALLOW_RETRIEVAL_MODE_OVERRIDE=false

# 公网服务保护。若部署平台通过可信反向代理转发真实 IP，再设置 TRUST_PROXY=true。
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=80
MODEL_RATE_LIMIT_MAX=30
TRUST_PROXY=false

# 可选：公网平台挂载的可写目录，仅保存 local-users；演示种子、缓存和 Case 库仍随镜像只读发布。
# DATA_DIR=/data/fridge-agent

# 可选：比赛排障用 Agent 运行记录。公网使用 CloudBase 文档数据库；本地未显式开启时保持关闭。
AGENT_RUNS_ENABLED=false
AGENT_RUNS_BACKEND=cloudbase
CLOUDBASE_ENV_ID=fridge-dinner-agent-d7bpec7d4611
CLOUDBASE_REGION=ap-shanghai
AGENT_RUNS_COLLECTION=agent_runs
AGENT_RUNS_AUTO_CREATE_COLLECTION=false
AGENT_RUNS_RETENTION_DAYS=7
# 比赛受控测试期设 true，保存白名单结构化库存与结果；仍不保存密钥、认证头、原始照片或原始音频。
AGENT_RUNS_CAPTURE_CONTENT=true
# 使用随机长字符串，保护 /api/admin/agent-runs 与 /ops.html 的数据查询。
AGENT_RUNS_ADMIN_TOKEN=请生成至少32位随机管理员令牌
AGENT_APP_VERSION=011
# CloudBase Run 优先使用平台自动身份或 CLOUDBASE_APIKEY；自建服务才按需配置专用最小权限密钥。
# CLOUDBASE_SECRET_ID=专用于运行记录数据库的SecretId
# CLOUDBASE_SECRET_KEY=专用于运行记录数据库的SecretKey

# 可选：语音转文字。auto 会按腾讯云一句话识别、显式开启的 Audio API、macOS Speech 依次降级。
SPEECH_TRANSCRIBE_PROVIDER=auto
# CloudBase 推荐：在平台 Secret 中配置以下两项，不要写入仓库。
# TENCENTCLOUD_SECRET_ID=你的腾讯云 SecretId
# TENCENTCLOUD_SECRET_KEY=你的腾讯云 SecretKey
# 使用临时凭证时同时配置 TENCENTCLOUD_SESSION_TOKEN。
TENCENT_ASR_ENABLED=true
TENCENT_ASR_ENGINE_TYPE=16k_zh
TENCENT_ASR_TIMEOUT_MS=20000
# 可选临时热词，格式为“词|权重,词|权重”。
# TENCENT_ASR_HOTWORD_LIST=番茄牛腩|8,黄焖鸡|8,空气炸锅|8,少洗锅|8

# 只有 provider 确认支持 OpenAI Audio Transcriptions 时才开启；Right Code 当前不作为 ASR provider。
AUDIO_TRANSCRIPTION_BASE_URL=https://right.codes/codex/v1
AUDIO_TRANSCRIPTION_MODELS=whisper-1,gpt-4o-mini-transcribe
AUDIO_TRANSCRIPTION_ENABLED=false

# 可选：Mac 本机语音转文字。默认优先设备端识别，设备端卡住时自动回退 macOS 系统识别。
MAC_SPEECH_LOCALE=zh-CN
MAC_SPEECH_ON_DEVICE_ONLY=true
MAC_SPEECH_AUTO_FALLBACK=true
